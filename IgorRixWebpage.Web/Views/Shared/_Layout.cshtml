@using Umbraco.Cms.Core.Web
@inject IUmbracoContextAccessor UmbracoContextAccessor
@model IgorRixWebpage.Web.Models.ViewModels.BasePageViewModel

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <!-- Styles -->
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
    <link rel="preconnect" href="https://googleapis.com">
    <link rel="preconnect" href="https://gstatic.com" crossorigin>
    <link href="https://googleapis.com/css2?family=Roboto+Slab:wght@700&display=swap" rel="anonymous">
</head>
<script>
    document.addEventListener('DOMContentLoaded', function () {

        const navToggle = document.querySelector('.nav-toggle');
        const navLinks = document.querySelector('.nav-links');

        const servicesDropdown =
            document.querySelector('.nav-dropdown');

        const servicesToggle =
            document.querySelector('.dropdown-toggle');


        /* Hamburger */

        if (navToggle && navLinks) {

            navToggle.addEventListener('click', function () {

                const isOpen =
                    navLinks.classList.toggle('is-open');

                navToggle.classList.toggle(
                    'is-active',
                    isOpen
                );

                navToggle.setAttribute(
                    'aria-expanded',
                    isOpen ? 'true' : 'false'
                );
            });
        }


        /* Services mobile submenu */

        if (servicesToggle && servicesDropdown) {

            servicesToggle.addEventListener(
                'click',
                function (event) {

                    if (window.innerWidth <= 425) {

                        event.preventDefault();
                        event.stopPropagation();

                        const isOpen =
                            servicesDropdown.classList.toggle(
                                'is-submenu-open'
                            );

                        servicesToggle.setAttribute(
                            'aria-expanded',
                            isOpen ? 'true' : 'false'
                        );
                    }
                }
            );
        }


        /* Reset mobile state when resizing */

        window.addEventListener('resize', function () {

            if (window.innerWidth > 425) {

                navLinks?.classList.remove('is-open');

                navToggle?.classList.remove('is-active');

                navToggle?.setAttribute(
                    'aria-expanded',
                    'false'
                );

                servicesDropdown?.classList.remove(
                    'is-submenu-open'
                );

                servicesToggle?.setAttribute(
                    'aria-expanded',
                    'false'
                );
            }
        });

    });
</script>

<body>
    <header class="site-header">
        <div class="header-main-grid">

            <!-- Left Node: Logo Block Alignment Base -->
            <div class="header-left-node">
                <a class="nav-logo-container" href="@Url.Content("~/")">
                    <div class="logo-fragment-box">
                        <div class="logo-main-text">
                            <span class="Roboto Slab">I</span>nclusive
                            <div class="logo-row-2">Access</div>
                        </div>
                        <div class="logo-subtext-line">no barriers</div>
                    </div>
                </a>
            </div>

            <!-- Center Node: Profile Info Axis -->
            <div class="header-center-node">
                <h1 class="header-business-profile-title">Business Profile & Services</h1>
                <p class="header-business-tagline">Just Access. Inclusion. Empowerment.</p>
            </div>

            <!-- Right Node: Contact Matrix Base Alignment -->
            <div class="header-right-node">
                @* <div class="header-personnel-block">
                    <span class="header-contact-name">Igor Rix</span>
                    <span class="header-contact-title">Director | Universal Access Consultant</span>
                </div> *@

                <div class="header-contact-methods">
                    <!-- Telephone link structure -->
                    <div class="header-phone-display">
                        <span class="header-phone-prefix">P:</span>
                        <a href="tel:0837030707" class="header-phone-number">083 703 0707</a>
                    </div>

                    <!-- Email contact structure -->
                    <div class="header-email-display">
                        <span class="header-email-prefix">E:</span>
                        <a href="mailto:igor@inclusive-access.co.za"
                           class="header-email-address">igor@inclusive-access.co.za</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Secondary Navigation Strip -->
        @{
            var currentPage = UmbracoContextAccessor
                .GetRequiredUmbracoContext()
                .PublishedRequest
                ?.PublishedContent;

            var rootPage = currentPage?.Root();

            var servicesPage = rootPage?
                .Children()
                .FirstOrDefault(x => x.Url().TrimEnd('/') == "/services");

            var serviceChildren = servicesPage?
                .Children()
                .Where(x => x.IsVisible())
                .ToList();
        }

        <nav class="navbar">
            <div class="nav-container">

                <button class="nav-toggle" type="button" aria-label="Toggle navigation" aria-expanded="false"
                        aria-controls="main-navigation">
                    <span></span>
                    <span></span>
                    <span></span>
                </button>

                <ul class="nav-links" id="main-navigation">

                    <li>
                        <a href="@Url.Content("~/")">
                            Home
                        </a>
                    </li>

                    <li>
                        <a href="@Url.Content("~/about-us")">
                            About Us
                        </a>
                    </li>

                    <li class="nav-dropdown">

                        <a href="@Url.Content("~/services")" class="dropdown-toggle" aria-haspopup="true"
                           aria-expanded="false">

                            <span>Services</span>

                            @if (serviceChildren?.Any() == true)
                            {
                                <span class="dropdown-arrow">▾</span>
                            }

                        </a>

                        @if (serviceChildren?.Any() == true)
                        {
                            <ul class="dropdown-menu">

                                @foreach (var service in serviceChildren)
                                {
                                    <li>
                                        <a href="@service.Url()">
                                            @service.Name
                                        </a>
                                    </li>
                                }

                            </ul>
                        }

                    </li>

                </ul>
            </div>
        </nav>
        <!--navbar end-->
    </header>

    <!--Sample Text-->
    <main role='main'>
        @RenderBody()
    </main>

    <!-- Your Footer Code -->
    <footer class="footer">
        <div class="footer-container">

            <!-- Left Side: Vertical Navigation Hub -->
            <div class="footer-nav-column">
                <h3 class="footer-heading">Quick Links</h3>
                <ul class="footer-vertical-links">
                    <li><a href="@Url.Content("~/")">Home</a></li>
                    <li><a href="@Url.Content("~/about-us")">About Us</a></li>
                    <li><a href="@Url.Content("~/services")">Services</a></li>
                </ul>
            </div>

            <!-- Right Side: Anchored Contact Profile Credentials -->
            <div class="footer-contact-column">
                <h3 class="footer-heading">Contact Details</h3>
                <div class="footer-personnel">
                    <span class="footer-name">Igor Rix</span>
                    <span class="footer-title">Director | Universal Access Consultant</span>
                </div>
                <div class="footer-methods">
                    <div class="footer-method-item">
                        <span class="method-prefix">P:</span>
                        <a href="tel:0837030707" class="method-link">083 703 0707</a>
                    </div>
                    <div class="footer-method-item">
                        <span class="method-prefix">E:</span>
                        <a href="mailto:igor@inclusive-access.co.za" class="method-link">igor@inclusive-access.co.za</a>
                    </div>
                </div>
            </div>

        </div>

        <!-- Bottom Metadata Baseline -->
        <div class="footer-bottom-bar">
            <p>&copy; @DateTime.Now.Year Inclusive Access. All rights reserved.</p>
        </div>
    </footer>
</body>